# TeamDesk 环境变量（复制为 .env 后填写）
#
# 三项都不填也能跑：无 LLM_API_KEY 时进入【离线模式】，
# 数字员工走规则兜底（pandas 统计 / 关键词 RAG / 关键词分桶），全部黄金路径可用。

# OpenAI 兼容接口地址（DeepSeek / OpenAI / vLLM / Ollama 均可）
LLM_BASE_URL=https://api.deepseek.com/v1

# 不填 = 离线模式
LLM_API_KEY=

# 模型名（跟随你的服务商）
LLM_MODEL=deepseek-chat

# 可选：数据目录（默认 backend/data，docker 下请保持默认以便 volume 映射）
# TEAMDESK_DATA_DIR=/app/data
